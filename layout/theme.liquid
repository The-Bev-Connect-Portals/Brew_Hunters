<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#16241E">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- liquid
    # Shopify only fills page_description when the resource has an SEO
    # description set. Most of ours don't, so fall back to the resource's own
    # body copy rather than shipping a page with no description at all.
    assign meta_description = page_description
    if meta_description == blank
      case request.page_type
        when 'product'
          assign meta_description = product.description | strip_html | truncate: 155
        when 'collection'
          assign meta_description = collection.description | strip_html | truncate: 155
        when 'page'
          assign meta_description = page.content | strip_html | truncate: 155
      endcase
    endif
  -%}
  {% if meta_description != blank %}<meta name="description" content="{{ meta_description | escape }}">{% endif %}

  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=DM+Mono:wght@400;500&family=Hanken+Grotesk:wght@400;500;700&display=swap">

  {{ 'base.css' | asset_url | stylesheet_tag }}

  {% render 'meta-tags' %}
  {% render 'structured-data' %}
  {{ content_for_header }}
</head>

<body class="template-{{ template.name }}">
  <a class="visually-hidden" href="#main-content">{{ 'accessibility.skip_to_content' | t }}</a>

  {% render 'icon-sprite' %}

  {% sections 'header-group' %}

  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'cart-drawer' %}

  <script src="{{ 'brew-hunters.js' | asset_url }}" defer></script>
</body>
</html>
