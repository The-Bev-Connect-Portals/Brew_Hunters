<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#16241E">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>
    {%- if request.page_type == 'index' -%}
      Brew Hunters | Craft Beer Delivered — Central Coast Breweries &amp; Beer Gifts
    {%- else -%}
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    {%- endif -%}
  </title>

  {%- liquid
    # Use the resource's SEO description when set; otherwise fall back to its
    # own copy; otherwise a store-level default so no page ships without one.
    assign meta_description = page_description
    if meta_description == blank
      case request.page_type
        when 'index'
          assign meta_description = 'Shop craft beer online from Brew Hunters in Ventura, CA. Topa Topa, Figueroa Mountain, Rincon, Mother Earth and more — 6-packs, singles, samplers and beer gifts. 21+.'
        when 'product'
          assign meta_description = product.description | strip_html | strip_newlines | truncate: 155
        when 'collection'
          assign meta_description = collection.description | strip_html | strip_newlines | truncate: 155
        when 'page'
          assign meta_description = page.content | strip_html | strip_newlines | truncate: 155
      endcase
    endif
    if meta_description == blank
      assign meta_description = 'Brew Hunters sells craft beer online from Ventura, CA. Owned and operated by Go-To Gifting, LLC. Adult 21+ signature required at delivery.'
    endif
  -%}
  <meta name="description" content="{{ meta_description | escape }}">

  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=DM+Mono:wght@400;500&family=Hanken+Grotesk:wght@400;500;700&display=swap">

  {{ 'base.css' | asset_url | stylesheet_tag }}

  {% render 'meta-tags', meta_description: meta_description %}

  {%- comment -%}
    JSON-LD is inlined here rather than living in a snippet. A snippet render
    hard-errors on every page if the file is missing, and the Shopify GitHub
    sync did exactly that once: layout/theme.liquid arrived, the new snippet
    did not, and every page printed a Liquid error. theme.liquid already
    exists in the live theme, so editing it can't fail the same way.
    OnlineStore (every page) / Product / BreadcrumbList / CollectionPage / WebSite.
    No aggregateRating or review - there are none, and inventing them risks
    a manual action.
  {%- endcomment -%}
{%- liquid
  assign shop_url = shop.url
  assign currency = cart.currency.iso_code | default: shop.currency
-%}

    {%- comment -%} Business identity: must match Merchant Center exactly. {%- endcomment -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "OnlineStore",
      "name": "Brew Hunters",
      "legalName": "Go-To Gifting, LLC",
      "url": {{ shop.url | json }},
      {%- if settings.logo %}"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},{% endif %}
      "email": "beerme@brewhunters.com",
      "telephone": "+1-844-446-2443",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2264 Goodyear Ave STE C",
        "addressLocality": "Ventura",
        "addressRegion": "CA",
        "postalCode": "93003",
        "addressCountry": "US"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "telephone": "+1-844-446-2443",
        "email": "beerme@brewhunters.com",
        "areaServed": "US"
      }
    }
    </script>

{%- case request.page_type -%}

  {%- when 'product' -%}
    {%- assign v = product.selected_or_first_available_variant -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ product.url | prepend: shop_url | json }},
      {%- if product.featured_media -%}
        "image": [{{ product.featured_media | image_url: width: 1200 | prepend: "https:" | json }}],
      {%- endif -%}
      "description": {{ product.description | strip_html | truncate: 500 | json }},
      {%- if product.vendor != blank -%}
        "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      {%- endif -%}
      {%- if v.sku != blank -%}
        "sku": {{ v.sku | json }},
      {%- endif -%}
      {%- if v.barcode != blank -%}
        "gtin": {{ v.barcode | json }},
      {%- endif -%}
      "offers": {
        "@type": "Offer",
        "url": {{ product.url | prepend: shop_url | json }},
        "priceCurrency": {{ currency | json }},
        "price": {{ v.price | divided_by: 100.0 | json }},
        "availability": {%- if v.available -%}"https://schema.org/InStock"{%- else -%}"https://schema.org/OutOfStock"{%- endif -%},
        "itemCondition": "https://schema.org/NewCondition",
        "seller": { "@type": "Organization", "name": "Brew Hunters" }
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop_url | json }} },
        {%- if collection -%}
          { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | prepend: shop_url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
        {%- else -%}
          { "@type": "ListItem", "position": 2, "name": {{ product.title | json }} }
        {%- endif -%}
      ]
    }
    </script>

  {%- when 'collection' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "url": {{ collection.url | prepend: shop_url | json }},
      {%- if collection.description != blank -%}
        "description": {{ collection.description | strip_html | truncate: 500 | json }},
      {%- endif -%}
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count | json }},
        "itemListElement": [
          {%- for p in collection.products limit: 24 -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "url": {{ p.url | prepend: shop_url | json }},
              "name": {{ p.title | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop_url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }} }
      ]
    }
    </script>

  {%- when 'index' -%}
    {%- assign search_url_template = shop_url | append: '/search?q={search_term_string}' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ search_url_template | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>

{%- endcase -%}
  {{ content_for_header }}
</head>

<body class="template-{{ template.name }}">
  <a class="visually-hidden" href="#main-content">{{ 'accessibility.skip_to_content' | t }}</a>

  {% render 'icon-sprite' %}

  {% sections 'header-group' %}

  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'cart-drawer' %}

  <script src="{{ 'brew-hunters.js' | asset_url }}" defer></script>
</body>
</html>
