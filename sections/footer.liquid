<footer class="foot scheme scheme--{{ section.settings.color_scheme | default: 'spruce' }}" id="{{ section.settings.anchor | default: 'ship' }}">
  <div class="wrap">
    <div class="foot__cols">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}

            {%- when 'text' -%}
              <h4>{{ block.settings.heading }}</h4>
              <p style="font-size:.95rem;opacity:.85;max-width:34ch">{{ block.settings.text }}</p>

            {%- when 'contact' -%}
              <h4>{{ block.settings.heading }}</h4>
              <address style="font-style:normal;font-size:.95rem;opacity:.85;line-height:1.6">
                <strong>{{ block.settings.business_name }}</strong><br>
                {{ block.settings.legal_line }}<br>
                {{ block.settings.street }}<br>
                {{ block.settings.city_line }}<br>
                <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | prepend: '+1' }}">{{ block.settings.phone }}</a><br>
                <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
              </address>

            {%- when 'menu' -%}
              <h4>{{ block.settings.heading }}</h4>
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>

            {%- when 'family' -%}
              <h4>{{ block.settings.heading }}</h4>
              {%- if block.settings.text != blank -%}
                <p style="font-size:.95rem;opacity:.85;max-width:34ch">{{ block.settings.text }}</p>
              {%- endif -%}
              <ul>
                {%- for i in (1..4) -%}
                  {%- liquid
                    assign label_key = 'label_' | append: i
                    assign url_key = 'url_' | append: i
                    assign label = block.settings[label_key]
                    assign url = block.settings[url_key]
                  -%}
                  {%- if label != blank and url != blank -%}
                    <li><a href="{{ url }}">{{ label }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'newsletter' -%}
              <h4>{{ block.settings.heading }}</h4>
              {%- if block.settings.text != blank -%}
                <p style="font-size:.95rem;opacity:.85">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- form 'customer', class: 'signup' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="newsletter-email">{{ 'general.newsletter.placeholder' | t }}</label>
                <input id="newsletter-email" type="email" name="contact[email]"
                       placeholder="{{ 'general.newsletter.placeholder' | t }}" autocomplete="email" required>
                <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
                {%- if form.posted_successfully? -%}
                  <p class="eyebrow" style="margin-top:.6rem">{{ 'general.newsletter.success' | t }}</p>
                {%- endif -%}
              {%- endform -%}

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.wordmark != blank -%}
      <p class="foot__word" aria-hidden="true">{{ section.settings.wordmark }}</p>
    {%- endif -%}

    <nav class="foot__policies" aria-label="Store policies" style="display:flex;flex-wrap:wrap;gap:.4rem 1.2rem;font-size:.85rem;margin:1rem 0">
      {%- for policy in shop.policies -%}
        <a href="{{ policy.url }}">{{ policy.title }}</a>
      {%- endfor -%}
      <a href="/pages/about-us">About Us</a>
      <a href="/pages/contact">Contact</a>
    </nav>

    <div class="foot__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ section.settings.legal_line }}</span>
      <span>{{ settings.age_notice }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "spruce", "label": "Spruce" },
        { "value": "surf", "label": "Surf" }
      ],
      "default": "spruce"
    },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "ship" },
    { "type": "text", "id": "wordmark", "label": "Outline wordmark", "default": "Brew Hunters" },
    { "type": "text", "id": "legal_line", "label": "Legal line", "default": "Owned and operated by Go-To Gifting, LLC · Ventura, CA" }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Where we ship" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Beer ships from Ventura, CA to U.S. states that permit direct-to-consumer beer shipment. Eligibility is confirmed at checkout." }
      ]
    },
    {
      "type": "contact",
      "name": "Business contact",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
        { "type": "text", "id": "business_name", "label": "Business name", "default": "Brew Hunters" },
        { "type": "text", "id": "legal_line", "label": "Legal line", "default": "Owned and operated by Go-To Gifting, LLC" },
        { "type": "text", "id": "street", "label": "Street", "default": "2264 Goodyear Ave STE C" },
        { "type": "text", "id": "city_line", "label": "City / state / ZIP", "default": "Ventura, CA 93003" },
        { "type": "text", "id": "phone", "label": "Phone", "default": "(844) 446-2443" },
        { "type": "text", "id": "email", "label": "Email", "default": "beerme@brewhunters.com" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "family",
      "name": "Family of sites",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Our other shops" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Same team, same Ventura warehouse." },
        { "type": "text", "id": "label_1", "label": "Link 1 label", "default": "The BroBasket \u2014 liquor gift baskets" },
        { "type": "url", "id": "url_1", "label": "Link 1 URL" },
        { "type": "text", "id": "label_2", "label": "Link 2 label", "default": "BoozeFinders \u2014 spirits & wine" },
        { "type": "url", "id": "url_2", "label": "Link 2 URL" },
        { "type": "text", "id": "label_3", "label": "Link 3 label", "default": "Night Shift Gifts \u2014 new-parent gifts" },
        { "type": "url", "id": "url_3", "label": "Link 3 URL" },
        { "type": "text", "id": "label_4", "label": "Link 4 label" },
        { "type": "url", "id": "url_4", "label": "Link 4 URL" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Get the drop list" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "New releases and limited cans, once a week." }
      ]
    }
  ]
}
{% endschema %}
