<header class="hdr">
  <div class="wrap hdr__in">
    <a class="mark" href="{{ routes.root_url }}">
      {%- if settings.logo -%}
        <img src="{{ settings.logo | image_url: width: 320 }}" alt="{{ shop.name | escape }}" width="160" height="44">
      {%- else -%}
        <svg><use href="#hop"/></svg>{{ settings.wordmark | default: shop.name }}
      {%- endif -%}
    </a>

    <nav class="nav" aria-label="Main">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links.size > 0 -%}
          <details class="nav__dd" data-nav-dd>
            <summary{% if link.child_active %} aria-current="true"{% endif %}>{{ link.title }}</summary>
            <div class="nav__panel">
              {%- for child in link.links -%}
                <a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>
              {%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="hdr__right">
      <button class="hdr__toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="nav-drawer">
        {{ 'accessibility.menu' | t }}
      </button>
      <a class="bag" href="{{ routes.cart_url }}">
        Cart · <span data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="wrap hdr__drawer" id="nav-drawer">
    {%- for link in section.settings.menu.links -%}
      {%- if link.links.size > 0 -%}
        <p class="hdr__drawer-head">{{ link.title }}</p>
        <div class="hdr__drawer-sub">
          {%- for child in link.links -%}
            <a href="{{ child.url }}">{{ child.title }}</a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
