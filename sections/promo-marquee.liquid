{%- liquid
  assign scheme = section.settings.color_scheme | default: 'spruce'
-%}
<div class="promo scheme scheme--{{ scheme }}" style="--speed:{{ section.settings.speed }}s" aria-label="Store announcements">
  <div class="promo__track">
    {%- for i in (1..2) -%}
      <div class="promo__group"{% if forloop.index == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          <svg class="hop"><use href="#hop"/></svg>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Promo marquee",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "spruce", "label": "Spruce" },
        { "value": "ember", "label": "Ember" },
        { "value": "gold", "label": "Gold" },
        { "value": "surf", "label": "Surf" }
      ],
      "default": "spruce"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 38
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Build your own 6 or 12 can box" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo marquee",
      "blocks": [
        { "type": "message", "settings": { "text": "Build your own 6 or 12 can box" } },
        { "type": "message", "settings": { "text": "Craft beer shipped from Ventura, CA" } },
        { "type": "message", "settings": { "text": "Adult 21+ signature required at delivery" } },
        { "type": "message", "settings": { "text": "Great craft breweries, one box" } }
      ]
    }
  ]
}
{% endschema %}
