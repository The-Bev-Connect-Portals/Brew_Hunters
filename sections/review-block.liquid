{%- comment -%}
  Review block. Ships in placeholder mode — the placeholder badge stays
  visible until real reviews are wired in from the review app.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme | default: 'surf'
-%}
<section class="band scheme scheme--{{ scheme }}">
  <div class="wrap quote__row">
    <div class="armed">
      {%- if section.settings.placeholder -%}
        <p class="eyebrow" style="margin-bottom:1.2rem">
          <span class="tag-placeholder">{{ section.settings.placeholder_label }}</span>
        </p>
      {%- elsif section.settings.eyebrow != blank -%}
        <p class="eyebrow" style="margin-bottom:1.2rem">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <p class="quote">{{ section.settings.quote }}</p>
    </div>
    {%- if section.settings.meta != blank -%}
      <p class="quote__meta armed">{{ section.settings.meta | newline_to_br }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Review block",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "surf", "label": "Surf" },
        { "value": "spruce", "label": "Spruce" },
        { "value": "ember", "label": "Ember" },
        { "value": "gold", "label": "Gold" }
      ],
      "default": "surf"
    },
    {
      "type": "checkbox",
      "id": "placeholder",
      "label": "Mark as placeholder",
      "info": "Leave on until real reviews are connected. Do not publish invented reviews as real.",
      "default": true
    },
    { "type": "text", "id": "placeholder_label", "label": "Placeholder badge", "default": "Placeholder review — sample copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (when not placeholder)" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "\"Got Topa Topa in Sacramento two days after ordering. Still cold.\"" },
    { "type": "textarea", "id": "meta", "label": "Meta", "default": "Sample layout only\nLive reviews pull from\nthe review app of choice" }
  ],
  "presets": [{ "name": "Review block" }]
}
{% endschema %}
