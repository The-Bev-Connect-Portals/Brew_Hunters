{%- comment -%}
  Build a box.

  The box itself is a single Shopify product (section setting `box_product`)
  sold at a flat rate. The twelve chosen cans ride along as cart line-item
  properties so ShipStation and the pack bench see the contents on the order.

  Inventory note: the box product decrements, the individual cans do not.
  Pick line is written as "Cans" plus one indexed property per line so the
  pick list stays readable in the Shopify admin.
{%- endcomment -%}

{%- liquid
  assign scheme = section.settings.color_scheme | default: 'fog'
  assign coll = section.settings.collection
  assign box = section.settings.box_product
  assign box_variant = box.selected_or_first_available_variant
  assign cap = section.settings.capacity
-%}

<div class="band scheme scheme--{{ scheme }}" style="padding-block:0">
  <div class="wrap crumbs">
    <a href="{{ routes.all_products_collection_url }}">Shop beer</a>
    <span>/</span>
    <span>{{ section.settings.heading }}</span>
  </div>
</div>

<section class="band scheme scheme--{{ scheme }}" style="padding-top:.5rem">
  <div class="wrap">
    <div class="band__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--clay">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
    </div>

    {%- if coll == blank or box == blank -%}
      <p class="pdp__rowlabel">
        Set both a source collection and a box product in the theme editor to activate the builder.
      </p>
    {%- else -%}

      <div class="box"
           data-box
           data-capacity="{{ cap }}"
           data-add-url="{{ routes.cart_add_url }}"
           data-cart-url="{{ routes.cart_url }}">

        <!-- ---------- tray ---------- -->
        <div class="tray">
          <p class="eyebrow" style="color:var(--gold)">{{ section.settings.tray_label }}</p>

          <div class="tray__grid" data-tray>
            {%- for i in (1..cap) -%}
              <div class="slot" data-slot></div>
            {%- endfor -%}
          </div>

          <div class="meter"><i data-meter></i></div>

          <div class="tray__foot">
            <p class="tray__count"><b data-count>0</b> of {{ cap }} cans</p>
            <p class="tray__count">{{ box_variant.price | money }}</p>
          </div>

          <form method="post" action="{{ routes.cart_add_url }}" data-box-form>
            <input type="hidden" name="id" value="{{ box_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <div data-box-props></div>
            <div class="tray__foot">
              <button class="cta cta--gold cta--block" type="submit" data-box-add disabled>
                {{ 'sections.build_a_box.incomplete' | t: total: cap }}
              </button>
            </div>
          </form>

          <p class="pdp__rowlabel" style="color:rgba(237,227,206,.6);text-align:center;margin-top:.8rem">
            {{ settings.signature_notice }}
          </p>
        </div>

        <!-- ---------- picker ---------- -->
        <div>
          {%- if section.blocks.size > 0 -%}
            <p class="eyebrow eyebrow--clay" style="margin-bottom:.6rem">{{ section.settings.preset_label }}</p>
            <div class="presets">
              {%- for block in section.blocks -%}
                <button class="preset"
                        type="button"
                        data-preset="{{ block.settings.tag | escape }}"
                        {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
              {%- endfor -%}
              <button class="preset" type="button" data-preset="__clear">
                {{ 'sections.build_a_box.clear' | t }}
              </button>
            </div>
          {%- endif -%}

          <div class="picker">
            {%- for product in coll.products limit: 40 -%}
              {%- liquid
                assign pv = product.selected_or_first_available_variant
                assign tagstr = product.tags | join: ','
              -%}
              {%- if product.available -%}
                <div class="pick"
                     data-pick
                     data-id="{{ pv.id }}"
                     data-title="{{ product.title | escape }}"
                     data-vendor="{{ product.vendor | escape }}"
                     data-tags="{{ tagstr | escape }}"
                     data-img="{{ product.featured_media | image_url: width: 160 }}">
                  <div class="pick__img">
                    {%- if product.featured_media -%}
                      <img src="{{ product.featured_media | image_url: width: 160 }}"
                           alt="{{ product.title | escape }}"
                           width="58" height="58" loading="lazy">
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  </div>
                  <div>
                    <b>{{ product.title }}</b>
                    <span>{{ product.vendor }}{% if product.type != blank %} · {{ product.type }}{% endif %}</span>
                  </div>
                  <div class="qty">
                    <button type="button" data-step="-1" aria-label="Remove one {{ product.title | escape }}">&minus;</button>
                    <output data-qty>0</output>
                    <button type="button" data-step="1" aria-label="Add one {{ product.title | escape }}">+</button>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Build a box",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "fog", "label": "Fog" },
        { "value": "paper", "label": "Paper" }
      ],
      "default": "fog"
    },
    {
      "type": "product",
      "id": "box_product",
      "label": "Box product",
      "info": "The flat-rate product that carries the price and decrements inventory."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Source collection",
      "info": "Singles available to pick from."
    },
    { "type": "range", "id": "capacity", "label": "Cans per box", "min": 4, "max": 24, "step": 2, "default": 12 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mixed 12 · one flat rate" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your box" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Pick any twelve singles across all four breweries. One flat rate for the box, shipped cold — same rate no matter what you put in it." },
    { "type": "text", "id": "tray_label", "label": "Tray label", "default": "Your box" },
    { "type": "text", "id": "preset_label", "label": "Presets label", "default": "Quick fill" }
  ],
  "blocks": [
    {
      "type": "preset",
      "name": "Quick fill preset",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "IPA hunt" },
        {
          "type": "text",
          "id": "tag",
          "label": "Product tag to fill from",
          "info": "Fills the box with available singles carrying this tag.",
          "default": "ipa"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Build a box",
      "blocks": [
        { "type": "preset", "settings": { "label": "IPA hunt", "tag": "ipa" } },
        { "type": "preset", "settings": { "label": "Easy drinking", "tag": "lager" } },
        { "type": "preset", "settings": { "label": "Brewery tour", "tag": "__tour" } }
      ]
    }
  ]
}
{% endschema %}
